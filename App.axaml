<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:converters="using:MicroPanelAvalonia.Converters"
             x:Class="MicroPanelAvalonia.App"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <sty:FluentAvaloniaTheme />
    <StyleInclude Source="avares://MicroPanelAvalonia/Styles/NavigationSidebar.axaml" />
  </Application.Styles>

  <Application.Resources>
    <FontFamily x:Key="SymbolThemeFontFamily">avares://FluentAvalonia/Fonts#Symbols</FontFamily>
    <converters:OnlineStatusBrushConverter x:Key="OnlineStatusBrushConverter"/>
    <converters:OnlineStatusTextConverter x:Key="OnlineStatusTextConverter"/>
    <converters:CpuUsageConverter x:Key="CpuUsageConverter"/>
    <converters:RamUsageConverter x:Key="RamUsageConverter"/>
    <converters:DiskUsageConverter x:Key="DiskUsageConverter"/>
  </Application.Resources>
</Application>
