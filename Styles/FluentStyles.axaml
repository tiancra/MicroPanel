<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================ -->
  <!-- MicroPanel Fluent Design System -->
  <!-- 基于 ClassIsland 和 Fluent Design 设计规范 -->
  <!-- ============================================ -->

  <!-- 颜色资源 -->
  <ResourceDictionary.ThemeDictionaries>
    <!-- 亮色主题 -->
    <ResourceDictionary x:Key="Light">
      <!-- 主色调 -->
      <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
      <SolidColorBrush x:Key="AccentLightBrush" Color="#E6F2FF"/>
      <SolidColorBrush x:Key="AccentDarkBrush" Color="#005A9E"/>

      <!-- 背景色 -->
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F9F9F9"/>
      <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F3F3F3"/>
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#FFFFFF"/>

      <!-- 文字颜色 -->
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F5F5F"/>
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9E9E9E"/>
      <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

      <!-- 边框颜色 -->
      <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
      <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5E5"/>
      <SolidColorBrush x:Key="DividerBrush" Color="#EBEBEB"/>

      <!-- 状态颜色 -->
      <SolidColorBrush x:Key="SuccessBrush" Color="#107C10"/>
      <SolidColorBrush x:Key="WarningBrush" Color="#FFB900"/>
      <SolidColorBrush x:Key="ErrorBrush" Color="#D13438"/>
      <SolidColorBrush x:Key="InfoBrush" Color="#0078D4"/>

      <!-- 导航 -->
      <SolidColorBrush x:Key="NavItemForegroundBrush" Color="#1A1A1A"/>
      <SolidColorBrush x:Key="NavItemForegroundSelectedBrush" Color="#0078D4"/>
      <SolidColorBrush x:Key="NavItemBackgroundSelectedBrush" Color="#E6F2FF"/>
      <SolidColorBrush x:Key="NavItemBackgroundHoverBrush" Color="#E8E8E8"/>
      <SolidColorBrush x:Key="NavIndicatorBrush" Color="#0078D4"/>

      <!-- 系统颜色 -->
      <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FDE7E9"/>
    </ResourceDictionary>

    <!-- 暗色主题 -->
    <ResourceDictionary x:Key="Dark">
      <!-- 主色调 -->
      <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF"/>
      <SolidColorBrush x:Key="AccentLightBrush" Color="#1A3A4A"/>
      <SolidColorBrush x:Key="AccentDarkBrush" Color="#7ECBFF"/>

      <!-- 背景色 -->
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020"/>
      <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1E1E1E"/>
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D2D"/>
      <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#2D2D2D"/>

      <!-- 文字颜色 -->
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CFCFCF"/>
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9E9E9E"/>
      <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000"/>

      <!-- 边框颜色 -->
      <SolidColorBrush x:Key="BorderBrush" Color="#3D3D3D"/>
      <SolidColorBrush x:Key="CardBorderBrush" Color="#3D3D3D"/>
      <SolidColorBrush x:Key="DividerBrush" Color="#3D3D3D"/>

      <!-- 状态颜色 -->
      <SolidColorBrush x:Key="SuccessBrush" Color="#54B054"/>
      <SolidColorBrush x:Key="WarningBrush" Color="#FFC107"/>
      <SolidColorBrush x:Key="ErrorBrush" Color="#FF5252"/>
      <SolidColorBrush x:Key="InfoBrush" Color="#4CC2FF"/>

      <!-- 导航 -->
      <SolidColorBrush x:Key="NavItemForegroundBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="NavItemForegroundSelectedBrush" Color="#4CC2FF"/>
      <SolidColorBrush x:Key="NavItemBackgroundSelectedBrush" Color="#1A3A4A"/>
      <SolidColorBrush x:Key="NavItemBackgroundHoverBrush" Color="#3A3A3A"/>
      <SolidColorBrush x:Key="NavIndicatorBrush" Color="#4CC2FF"/>

      <!-- 系统颜色 -->
      <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#442726"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
