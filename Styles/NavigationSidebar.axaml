<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Windows 11 Style Navigation Sidebar with Animated Selection Indicator -->

  <Styles.Resources>
    <!-- 侧边栏背景色 -->
    <SolidColorBrush x:Key="NavigationSidebarBackgroundBrush" Color="#F5F9FF" />
    <SolidColorBrush x:Key="NavigationSidebarBackgroundBrushDark" Color="#1E1E1E" />

    <!-- 导航项背景色 -->
    <SolidColorBrush x:Key="NavigationItemBackgroundBrush" Color="Transparent" />
    <!-- 悬停时变深 -->
    <SolidColorBrush x:Key="NavigationItemBackgroundHoverBrush" Color="#D0E0F0" />
    <SolidColorBrush x:Key="NavigationItemBackgroundHoverBrushDark" Color="#3A3A3A" />
    <!-- 选中项背景为灰色 -->
    <SolidColorBrush x:Key="NavigationItemBackgroundSelectedBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="NavigationItemBackgroundSelectedBrushDark" Color="#3A3A3A" />

    <!-- 导航项文字颜色 -->
    <SolidColorBrush x:Key="NavigationItemForegroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="NavigationItemForegroundBrushDark" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavigationItemForegroundSelectedBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="NavigationItemForegroundSelectedBrushDark" Color="#4CC2FF" />

    <!-- 选中指示器颜色 -->
    <SolidColorBrush x:Key="NavigationSelectionIndicatorBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="NavigationSelectionIndicatorBrushDark" Color="#4CC2FF" />
  </Styles.Resources>

  <!-- ============================================ -->
  <!-- 侧边栏容器样式 -->
  <!-- ============================================ -->

  <Style Selector="Border.Sidebar">
    <Setter Property="Background" Value="{DynamicResource NavigationSidebarBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="BorderBrush" Value="#E0E8F0" />
    <Setter Property="Width" Value="240" />
  </Style>

  <Style Selector="Border.Sidebar:dark">
    <Setter Property="Background" Value="{DynamicResource NavigationSidebarBackgroundBrushDark}" />
    <Setter Property="BorderBrush" Value="#333333" />
  </Style>

  <!-- ============================================ -->
  <!-- 导航按钮样式 - 无内置指示器 -->
  <!-- ============================================ -->

  <Style Selector="Button.Navigation">
    <Setter Property="Background" Value="{DynamicResource NavigationItemBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NavigationItemForegroundBrush}" />
    <Setter Property="Padding" Value="22,10,16,10" />
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="40" />
  </Style>

  <!-- 悬停状态 - 使用更具体的选择器覆盖默认样式 -->
  <Style Selector="Button.Navigation:pointerover">
    <Setter Property="Background" Value="#D0E0F0" />
  </Style>
  <Style Selector="Button.Navigation:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#D0E0F0" />
  </Style>

  <!-- 选中状态 - 灰色背景 -->
  <Style Selector="Button.Navigation.Selected">
    <Setter Property="Background" Value="{DynamicResource NavigationItemBackgroundSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NavigationItemForegroundSelectedBrush}" />
  </Style>

  <!-- ============================================ -->
  <!-- 深色模式 -->
  <!-- ============================================ -->

  <Style Selector="Button.Navigation:dark">
    <Setter Property="Foreground" Value="{DynamicResource NavigationItemForegroundBrushDark}" />
  </Style>
  <Style Selector="Button.Navigation:pointerover:dark">
    <Setter Property="Background" Value="{DynamicResource NavigationItemBackgroundHoverBrushDark}" />
  </Style>
  <Style Selector="Button.Navigation.Selected:dark">
    <Setter Property="Background" Value="{DynamicResource NavigationItemBackgroundSelectedBrushDark}" />
    <Setter Property="Foreground" Value="{DynamicResource NavigationItemForegroundSelectedBrushDark}" />
  </Style>

  <!-- ============================================ -->
  <!-- 底部用户区域样式 -->
  <!-- ============================================ -->

  <Style Selector="Border.UserArea">
    <Setter Property="Background" Value="{DynamicResource NavigationItemBackgroundHoverBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="12,8" />
  </Style>

  <Style Selector="Border.UserArea:dark">
    <Setter Property="Background" Value="{DynamicResource NavigationItemBackgroundHoverBrushDark}" />
  </Style>

</Styles>
