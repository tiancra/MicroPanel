<local:MyWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:MicroPanel.Views"
        xmlns:pages="using:MicroPanel.Views.Pages"
        xmlns:controls="using:FluentAvalonia.UI.Controls"
        xmlns:customControls="using:MicroPanel.Views.Controls"
        xmlns:windowing="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
        xmlns:local="using:MicroPanel.Controls"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="MicroPanel.Views.MainAppWindow"
        Title="Micro Panel - 管理后台"
        Width="1400" Height="900"
        MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        TransparencyLevelHint="Mica"
        Background="Transparent"
        EnableMicaWindow="True"
        windowing:AppWindow.AllowInteractionInTitleBar="True"
        x:Name="MainWindow">

  <Grid>
    <controls:NavigationView x:Name="NavigationView"
                             PaneDisplayMode="Left"
                             IsSettingsVisible="False"
                             IsBackButtonVisible="False"
                             OpenPaneLength="280">
      <controls:NavigationView.MenuItems>
        <!-- 主页 -->
        <controls:NavigationViewItem Tag="Home" IsSelected="True">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M12,3L4,9v12h5v-7h6v7h5V9L12,3z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="首页" />
        </controls:NavigationViewItem>

        <!-- 系统状态 -->
        <controls:NavigationViewItem Tag="Status">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M4,6H20V16H4M2,18H22V20H2V18M20,4H4V6H20V4Z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="系统状态" />
        </controls:NavigationViewItem>

        <!-- 日志输出 -->
        <controls:NavigationViewItem Tag="Logs">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M9.4,16.6L4.8,12L9.4,7.4L8,6L2,12L8,18L9.4,16.6M14.6,16.6L19.2,12L14.6,7.4L16,6L22,12L16,18L14.6,16.6Z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="日志输出" />
        </controls:NavigationViewItem>

        <!-- 插件开发 -->
        <controls:NavigationViewItem Tag="Plugins">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M20.5,11H19V7C19,5.89 18.1,5 17,5H13V3.5A2.5,2.5 0 0,0 10.5,1A2.5,2.5 0 0,0 8,3.5V5H4A2,2 0 0,0 2,7V10.8H3.5C5,10.8 6.2,12 6.2,13.5C6.2,15 5,16.2 3.5,16.2H2V20A2,2 0 0,0 4,22H20A2,2 0 0,0 22,19V10A2,2 0 0,0 20.5,11Z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="插件开发" />
        </controls:NavigationViewItem>

        <!-- 文件管理 -->
        <controls:NavigationViewItem Tag="Files">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M20,6H12L10,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8A2,2 0 0,0 20,6Z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="文件管理" />
        </controls:NavigationViewItem>

        <!-- 沙盒调试 -->
        <controls:NavigationViewItem Tag="Sandbox">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M12,2L2,7V17C2,19.2 3.8,21 6,21H18C20.2,21 22,19.2 22,17V7L12,2M12,4.2L19.5,8H4.5L12,4.2M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="沙盒调试" />
        </controls:NavigationViewItem>

        <!-- 数据库 -->
        <controls:NavigationViewItem Tag="Database">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M12,3C16.4,3 20,4.8 20,7C20,9.2 16.4,11 12,11C7.6,11 4,9.2 4,7C4,4.8 7.6,3 12,3M4,9V12C4,14.2 7.6,16 12,16C16.4,16 20,14.2 20,12V9C20,11.2 16.4,13 12,13C7.6,13 4,11.2 4,9M4,14V17C4,19.2 7.6,21 12,21C16.4,21 20,19.2 20,17V14C20,16.2 16.4,18 12,18C7.6,18 4,16.2 4,14Z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="数据库" />
        </controls:NavigationViewItem>

        <!-- 配置分组 -->
        <controls:NavigationViewItemHeader Content="配置" />

        <!-- Bot配置 -->
        <controls:NavigationViewItem Tag="ConfigBot">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5Z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="Bot配置" />
        </controls:NavigationViewItem>

        <!-- 插件配置 -->
        <controls:NavigationViewItem Tag="ConfigPlugin">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M17,3H7A2,2 0 0,0 5,5V21L12,18L19,21V5C19,3.89 18.1,3 17,3Z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="插件配置" />
        </controls:NavigationViewItem>

        <!-- 权限配置 -->
        <controls:NavigationViewItem Tag="ConfigUser">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C9.33,14 4,15.34 4,18V20H20V18C20,15.34 14.67,14 12,14Z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="权限配置" />
        </controls:NavigationViewItem>

        <!-- 协议配置 -->
        <controls:NavigationViewItem Tag="ConfigProtocol">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6Z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="协议配置" />
        </controls:NavigationViewItem>

        <!-- 设置 -->
        <controls:NavigationViewItem Tag="Settings">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="设置" />
        </controls:NavigationViewItem>

        <!-- 关于 -->
        <controls:NavigationViewItem Tag="About">
          <controls:NavigationViewItem.IconSource>
            <controls:PathIconSource Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" />
          </controls:NavigationViewItem.IconSource>
          <TextBlock Text="关于" />
        </controls:NavigationViewItem>
      </controls:NavigationView.MenuItems>

      <!-- 底部用户信息区域 -->
      <controls:NavigationView.PaneFooter>
        <Border Background="{DynamicResource LayerBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- 用户头像 -->
            <Border Grid.Column="0"
                    Width="36" Height="36"
                    CornerRadius="18"
                    Background="{DynamicResource AccentBrush}"
                    ClipToBounds="True">
              <Grid>
                <Image x:Name="UserAvatarImage"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="False"/>
                <TextBlock x:Name="UserAvatarText"
                           Text="U"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextOnAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <!-- 用户信息 -->
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="UsernameText"
                         Text="用户名"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ServerAddressText"
                         Text="服务器地址"
                         FontSize="11"
                         Opacity="0.6"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 退出按钮 -->
            <Button Grid.Column="2"
                    Classes="Ghost"
                    Padding="8"
                    Click="OnLogoutClick"
                    ToolTip.Tip="退出登录">
              <PathIcon Data="M17,7L15.59,8.41L18.17,11H8V13H18.17L15.59,15.58L17,17L22,12M4,5H12V3H4A2,2 0 0,0 2,5V19A2,2 0 0,0 4,21H12V19H4V5Z"
                        Width="16" Height="16"
                        Opacity="0.7"
                        Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>
          </Grid>
        </Border>
      </controls:NavigationView.PaneFooter>

      <!-- 内容区域 - ClassIsland风格，无顶部标题栏 -->
      <Grid>
        <!-- 桌面壁纸控件 - 只在右侧内容区域显示 -->
        <customControls:DesktopWallpaperControl x:Name="WallpaperControl" ZIndex="0"/>

        <ContentControl x:Name="MainContentControl"
                        Margin="24"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
          <ContentControl.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
            </Transitions>
          </ContentControl.Transitions>
        </ContentControl>

        <!-- 调试模式水印 -->
        <Border x:Name="DebugModeWatermark"
                IsVisible="False"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Background="{DynamicResource ErrorBrush}"
                CornerRadius="6"
                Padding="12,6"
                Opacity="0.9">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="M20,8H17V6.5C17,4.57 15.43,3 13.5,3H10.5C8.57,3 7,4.57 7,6.5V8H4A2,2 0 0,0 2,10V19A2,2 0 0,0 4,21H20A2,2 0 0,0 22,19V10A2,2 0 0,0 20,8M9,6.5C9,5.67 9.67,5 10.5,5H13.5C14.33,5 15,5.67 15,6.5V8H9V6.5M20,19H4V10H20V19M12,17.5A2.5,2.5 0 0,1 9.5,15A2.5,2.5 0 0,1 12,12.5A2.5,2.5 0 0,1 14.5,15A2.5,2.5 0 0,1 12,17.5Z"
                      Width="14" Height="14"
                      Foreground="White"/>
            <TextBlock Text="调试模式"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="White"/>
          </StackPanel>
        </Border>
      </Grid>
    </controls:NavigationView>
  </Grid>
</local:MyWindow>
