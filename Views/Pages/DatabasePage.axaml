<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MicroPanel.Models"
             x:Class="MicroPanel.Views.Pages.DatabasePage">
  <UserControl.Styles>
    <!-- TreeViewItem 展开/折叠动画 -->
    <Style Selector="TreeViewItem">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- 子项展开时的动画 -->
    <Style Selector="TreeViewItem[IsExpanded=true] /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
        </Transitions>
      </Setter>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <!-- 标题栏 -->
    <Border Grid.Row="0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,16">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0"
                   Text="Redis 数据库"
                   FontSize="18"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        
        <!-- 分隔符设置 -->
        <StackPanel Grid.Column="1" 
                    Orientation="Horizontal" 
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock Text="分隔符:" 
                     VerticalAlignment="Center"
                     Opacity="0.8"/>
          <TextBox x:Name="SepTextBox"
                   Text=":"
                   Width="40"
                   VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- 操作按钮 -->
        <StackPanel Grid.Column="2" 
                    Orientation="Horizontal" 
                    Spacing="8">
          <Button x:Name="RefreshButton"
                  Click="OnRefreshClick">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                        Width="16" Height="16"/>
              <TextBlock Text="刷新"/>
            </StackPanel>
          </Button>
          <Button x:Name="AddRootButton"
                  Classes="Accent"
                  Click="OnAddRootClick">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                        Width="16" Height="16"/>
              <TextBlock Text="添加"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    
    <!-- 树形数据 -->
    <Border Grid.Row="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8"
            Padding="16">
      <TreeView x:Name="RedisTreeView"
                SelectionChanged="OnTreeSelectionChanged"
                DoubleTapped="OnTreeDoubleTapped">
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="models:RedisKeyNode"
                            ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Text="{Binding Name}"
                         VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" 
                          Orientation="Horizontal" 
                          Spacing="8">
                <Button Classes="Ghost"
                        Padding="4"
                        Click="OnAddChildClick"
                        Tag="{Binding}">
                  <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                            Width="14" Height="14"
                            Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                </Button>
                <Button Classes="Ghost"
                        Padding="4"
                        Click="OnDeleteClick"
                        Tag="{Binding}">
                  <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                            Width="14" Height="14"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </Button>
              </StackPanel>
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Border>
  </Grid>
</UserControl>
