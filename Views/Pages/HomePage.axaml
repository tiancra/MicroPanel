<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svc="using:MicroPanel.Services"
             xmlns:local="using:MicroPanel.Views.Pages"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="MicroPanel.Views.Pages.HomePage">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="24" Margin="0,0,0,24">

      <!-- 欢迎卡片 - Fluent Design 风格 -->
      <Border Background="{DynamicResource CardBackgroundBrush}"
              CornerRadius="16"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1"
              Padding="32"
              BoxShadow="0 4 20 0 #20000000">
        <Grid ColumnDefinitions="Auto,*">
          <!-- 头像 -->
          <Border Grid.Column="0"
                  Width="100" Height="100"
                  CornerRadius="50"
                  Background="{DynamicResource AccentBrush}"
                  VerticalAlignment="Center"
                  ClipToBounds="True"
                  BoxShadow="0 4 12 0 #30000000">
            <Grid>
              <Image x:Name="AvatarImage"
                     Stretch="UniformToFill"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="False"/>
              <TextBlock x:Name="AvatarText"
                         Text="U"
                         FontSize="40"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextOnAccentBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- 欢迎信息 -->
          <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="WelcomeText"
                       Text="你好！用户"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="HitokotoText"
                       Text="正在获取一言..."
                       FontSize="16"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Opacity="0.8"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Bot 信息列表 -->
      <Border Background="{DynamicResource CardBackgroundBrush}"
              CornerRadius="16"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1"
              Padding="24"
              BoxShadow="0 4 16 0 #15000000">
        <StackPanel Spacing="16">
          <!-- 标题 -->
          <StackPanel Orientation="Horizontal" Spacing="12">
            <PathIcon Data="M12,2A2,2 0 0,1 14,4V6H16A2,2 0 0,1 18,8V20A2,2 0 0,1 16,22H8A2,2 0 0,1 6,20V8A2,2 0 0,1 8,6H10V4A2,2 0 0,1 12,2M8,8V20H16V8H8M12,18A2,2 0 0,1 10,16A2,2 0 0,1 12,14A2,2 0 0,1 14,16A2,2 0 0,1 12,18Z"
                      Width="20" Height="20"
                      Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Bot 信息"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
          </StackPanel>

          <ItemsControl x:Name="BotInfoItemsControl">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:BotInfoViewModel">
                <Border Background="{DynamicResource LayerBackgroundBrush}"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,12"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- 头像 -->
                    <Border Grid.Column="0"
                            Width="56" Height="56"
                            CornerRadius="28"
                            Background="{DynamicResource AccentBrush}"
                            ClipToBounds="True">
                      <Grid>
                        <Image Source="{Binding AvatarBitmap}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsAvatarVisible}">
                          <Image.Clip>
                            <EllipseGeometry Rect="0,0,56,56"/>
                          </Image.Clip>
                        </Image>
                        <TextBlock Text="{Binding Nickname, StringFormat='{}{0:0}'}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextOnAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsTextAvatarVisible}"/>
                      </Grid>
                    </Border>

                    <!-- 昵称和平台 -->
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Nickname}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Border Background="{DynamicResource AccentLightBrush}"
                                CornerRadius="4"
                                Padding="6,2">
                          <TextBlock Text="{Binding Platform}"
                                     FontSize="11"
                                     Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding BotVersion, StringFormat='协议 {0}'}"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- 统计信息 -->
                    <WrapPanel Grid.Column="2"
                               VerticalAlignment="Center"
                               Orientation="Horizontal">
                      <!-- 好友数 -->
                      <Border Background="{DynamicResource AccentBrush}"
                              CornerRadius="6"
                              Padding="10,6"
                              Margin="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C9.33,14 4,15.34 4,18V20H20V18C20,15.34 14.67,14 12,14Z"
                                    Width="12" Height="12"
                                    Foreground="{DynamicResource TextOnAccentBrush}"/>
                          <TextBlock Text="{Binding CountContacts.Friend, StringFormat='好友 {0}'}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextOnAccentBrush}"/>
                        </StackPanel>
                      </Border>

                      <!-- 群组数 -->
                      <Border Background="{DynamicResource SuccessBrush}"
                              CornerRadius="6"
                              Padding="10,6"
                              Margin="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C9.33,14 4,15.34 4,18V20H20V18C20,15.34 14.67,14 12,14Z"
                                    Width="12" Height="12"
                                    Foreground="White"/>
                          <TextBlock Text="{Binding CountContacts.Group, StringFormat='群组 {0}'}"
                                     FontSize="12"
                                     Foreground="White"/>
                        </StackPanel>
                      </Border>

                      <!-- 群成员数 -->
                      <Border Background="{DynamicResource WarningBrush}"
                              CornerRadius="6"
                              Padding="10,6"
                              Margin="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C9.33,14 4,15.34 4,18V20H20V18C20,15.34 14.67,14 12,14Z"
                                    Width="12" Height="12"
                                    Foreground="White"/>
                          <TextBlock Text="{Binding CountContacts.GroupMember, StringFormat='成员 {0}'}"
                                     FontSize="12"
                                     Foreground="White"/>
                        </StackPanel>
                      </Border>

                      <!-- 接收消息 -->
                      <Border Background="{DynamicResource InfoBrush}"
                              CornerRadius="6"
                              Padding="10,6"
                              Margin="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="M20,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6A2,2 0 0,0 20,4M20,18H4V8L12,13L20,8V18M20,6L12,11L4,6V6H20V6Z"
                                    Width="12" Height="12"
                                    Foreground="White"/>
                          <TextBlock Text="{Binding MessageCount.Recv}"
                                     FontSize="12"
                                     Foreground="White"/>
                        </StackPanel>
                      </Border>

                      <!-- 发送消息 -->
                      <Border Background="{DynamicResource InfoBrush}"
                              CornerRadius="6"
                              Padding="10,6"
                              Margin="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"
                                    Width="12" Height="12"
                                    Foreground="White"/>
                          <TextBlock Text="{Binding MessageCount.Sent}"
                                     FontSize="12"
                                     Foreground="White"/>
                        </StackPanel>
                      </Border>

                      <!-- 运行时长 -->
                      <Border Background="{DynamicResource LayerBackgroundBrush}"
                              CornerRadius="6"
                              Padding="10,6"
                              Margin="4"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                    Width="12" Height="12"
                                    Opacity="0.6"/>
                          <TextBlock Text="{Binding BotRunTime}"
                                     FontSize="12"/>
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 空状态 -->
          <StackPanel x:Name="EmptyStatePanel"
                      Spacing="16"
                      HorizontalAlignment="Center"
                      Margin="0,48"
                      IsVisible="False">
            <Border Width="80"
                    Height="80"
                    CornerRadius="40"
                    Background="{DynamicResource LayerBackgroundBrush}">
              <PathIcon Data="M12,2A2,2 0 0,1 14,4V6H16A2,2 0 0,1 18,8V20A2,2 0 0,1 16,22H8A2,2 0 0,1 6,20V8A2,2 0 0,1 8,6H10V4A2,2 0 0,1 12,2M8,8V20H16V8H8M12,18A2,2 0 0,1 10,16A2,2 0 0,1 12,14A2,2 0 0,1 14,16A2,2 0 0,1 12,18Z"
                        Width="36" Height="36"
                        Opacity="0.3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="暂无 Bot 信息"
                       FontSize="16"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="连接服务器后将显示 Bot 状态"
                       FontSize="13"
                       Opacity="0.6"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
