<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:MicroPanelAvalonia.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="MicroPanelAvalonia.Views.Pages.StatusPage">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" Margin="0,0,0,20">

      <!-- 顶部控制栏 -->
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="12"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              Padding="20">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="系统状态实时监控"
                     FontSize="18"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
            <ToggleSwitch x:Name="AutoRefreshToggle"
                          Content="自动刷新"
                          IsChecked="True"/>
            <TextBlock x:Name="LastUpdateText"
                       Text="上次更新: --"
                       VerticalAlignment="Center"
                       Opacity="0.6"/>
            <Button x:Name="RefreshButton"
                    Classes="Accent"
                    Content="立即刷新"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 第一行：CPU、内存、GPU -->
      <Grid ColumnDefinitions="*,*,*" Classes="dashboard-grid">
        <!-- CPU -->
        <Border Grid.Column="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="20"
                Margin="0,0,10,0">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="CPU 占用"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <Grid Width="160" Height="160">
              <!-- 环形进度条 -->
              <controls:CircularProgressBar x:Name="CpuProgressBar"
                                           Value="0"
                                           Maximum="100"
                                           Diameter="160"
                                           StrokeThickness="12"
                                           BackgroundBrush="{DynamicResource LayerFillColorDefaultBrush}"/>
              <!-- 中心内容 -->
              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock x:Name="CpuPercentText"
                           Text="0%"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="CpuInfoText"
                       Text="--"
                       FontSize="12"
                       Opacity="0.6"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="180"/>
          </StackPanel>
        </Border>

        <!-- 内存 -->
        <Border Grid.Column="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="20"
                Margin="5,0,5,0">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="内存占用"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <Grid Width="160" Height="160">
              <!-- 环形进度条 -->
              <controls:CircularProgressBar x:Name="RamProgressBar"
                                           Value="0"
                                           Maximum="100"
                                           Diameter="160"
                                           StrokeThickness="12"
                                           BackgroundBrush="{DynamicResource LayerFillColorDefaultBrush}"/>
              <!-- 中心内容 -->
              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock x:Name="RamPercentText"
                           Text="0%"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="RamInfoText"
                       Text="--"
                       FontSize="12"
                       Opacity="0.6"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- GPU -->
        <Border Grid.Column="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="20"
                Margin="10,0,0,0">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="GPU 占用"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <Grid Width="160" Height="160">
              <!-- 环形进度条 -->
              <controls:CircularProgressBar x:Name="GpuProgressBar"
                                           Value="0"
                                           Maximum="100"
                                           Diameter="160"
                                           StrokeThickness="12"
                                           BackgroundBrush="{DynamicResource LayerFillColorDefaultBrush}"/>
              <!-- 中心内容 -->
              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock x:Name="GpuPercentText"
                           Text="--"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="GpuInfoText"
                       Text="未检测到GPU"
                       FontSize="12"
                       Opacity="0.6"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="180"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 第二行：磁盘和交换分区 -->
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="12"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              Padding="20">
        <StackPanel Spacing="16">
          <TextBlock Text="磁盘占用"
                     FontSize="16"
                     FontWeight="SemiBold"/>
          <StackPanel x:Name="DiskStackPanel" Spacing="12">
            <!-- 磁盘项将动态添加 -->
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 第三行：Node.js 堆栈信息 -->
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="12"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              Padding="20">
        <StackPanel Spacing="16">
          <TextBlock Text="Node.js 内存"
                     FontSize="16"
                     FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,*,*">
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
              <TextBlock x:Name="NodeRssText"
                         Text="0 MB"
                         FontSize="24"
                         FontWeight="SemiBold"/>
              <TextBlock Text="RSS"
                         FontSize="12"
                         Opacity="0.6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
              <TextBlock x:Name="NodeHeapTotalText"
                         Text="0 MB"
                         FontSize="24"
                         FontWeight="SemiBold"/>
              <TextBlock Text="堆总量"
                         FontSize="12"
                         Opacity="0.6"/>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
              <TextBlock x:Name="NodeHeapUsedText"
                         Text="0 MB"
                         FontSize="24"
                         FontWeight="SemiBold"/>
              <TextBlock Text="堆已用"
                         FontSize="12"
                         Opacity="0.6"/>
            </StackPanel>
          </Grid>
          <ProgressBar x:Name="NodeHeapProgressBar"
                       Value="0"
                       Maximum="100"
                       Height="8"
                       Background="{DynamicResource LayerFillColorDefaultBrush}"
                       Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
        </StackPanel>
      </Border>

      <!-- 第四行：其它信息 -->
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="12"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              Padding="20">
        <StackPanel Spacing="16">
          <TextBlock Text="其它信息"
                     FontSize="16"
                     FontWeight="SemiBold"/>
          <StackPanel x:Name="OtherInfoStackPanel" Spacing="8">
            <!-- 其它信息项将动态添加 -->
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 第五行：网络状态 -->
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="12"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              Padding="20">
        <StackPanel Spacing="16">
          <TextBlock Text="网络状态"
                     FontSize="16"
                     FontWeight="SemiBold"/>
          <StackPanel x:Name="NetworkStackPanel" Spacing="8">
            <!-- 网络信息项将动态添加 -->
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
