<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:MicroPanelAvalonia.Models"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="200"
             x:Class="MicroPanelAvalonia.Views.ServerCard"
             x:DataType="models:ServerInfo"
             Width="320" Height="200">

  <Border x:Name="CardBorder"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          BoxShadow="0 2 8 0 #20000000">

    <Grid RowDefinitions="Auto,*,Auto">

      <Border Grid.Row="0"
              Background="{DynamicResource AccentFillColorDefaultBrush}"
              CornerRadius="8,8,0,0"
              Padding="12,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding ServerAddress}"
                     Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                     FontWeight="SemiBold"
                     FontSize="14"
                     TextTrimming="CharacterEllipsis"/>

          <Ellipse Grid.Column="1"
                   Width="10" Height="10"
                   Fill="{Binding IsOnline, Converter={StaticResource OnlineStatusBrushConverter}}"
                   Margin="8,0,0,0"
                   ToolTip.Tip="{Binding IsOnline, Converter={StaticResource OnlineStatusTextConverter}}"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="12,12">

        <StackPanel Grid.Column="0" Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="M9,2v2H7V2H9M19,2v2H17V2H19M9,20v2H7V20H9M19,20v2H17V20H19M14,2v2H10V2H14M5,4h2V6H5V4M19,4h2V6H19V4M2,9h2v2H2V9M22,9h2v2H22V9M5,18h2v2H5V18M19,18h2v2H19V18M2,14h2v2H2V14M22,14h2v2H22V14M9,6h6v2H9V6M6,9h2v6H6V9M16,9h2v6H16V9M9,16h6v2H9V16Z"
                      Width="14" Height="14" Opacity="0.6"/>
            <TextBlock Text="CPU"
                       FontSize="12"
                       Opacity="0.6"/>
          </StackPanel>
          <TextBlock Text="{Binding Status.CpuInfo, Converter={StaticResource CpuUsageConverter}, FallbackValue='--'}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>

          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
            <PathIcon Data="M17,17H7V7H17M17,5H7A2,2 0 0,0 5,7V17A2,2 0 0,0 7,19H17A2,2 0 0,0 19,17V7A2,2 0 0,0 17,5Z"
                      Width="14" Height="14" Opacity="0.6"/>
            <TextBlock Text="内存"
                       FontSize="12"
                       Opacity="0.6"/>
          </StackPanel>
          <TextBlock Text="{Binding Status.RamInfo, Converter={StaticResource RamUsageConverter}, FallbackValue='--'}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
          <TextBlock Text="{Binding Users.Count, StringFormat='{}{0} 个用户'}"
                     FontSize="11"
                     Opacity="0.5"/>
          <TextBlock Text="{Binding LastUpdate, StringFormat='{}{0:HH:mm:ss}', FallbackValue='--'}"
                     FontSize="11"
                     Opacity="0.5"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="2"
              Background="{DynamicResource LayerFillColorDefaultBrush}"
              CornerRadius="0,0,8,8"
              Padding="12,8">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <PathIcon Data="M12,14a2,2 0 1,0 2,-2A2,2 0 0,0 12,14M4,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M4,6V18H20V6H4Z"
                      Width="14" Height="14" Opacity="0.6"/>
            <TextBlock Text="{Binding Status.DiskSizeInfo, Converter={StaticResource DiskUsageConverter}, FallbackValue='--'}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="Ghost"
                    Padding="4"
                    ToolTip.Tip="用户管理"
                    Click="OnUserManagementClick">
              <PathIcon Data="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z"
                        Width="16" Height="16" Opacity="0.6"/>
            </Button>
            <Button Classes="Ghost"
                    Padding="4"
                    ToolTip.Tip="删除服务器"
                    Click="OnDeleteClick">
              <PathIcon Data="M6,19c0,1.1 0.9,2 2,2h8c1.1,0 2,-0.9 2,-2V7H6v12zM19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z"
                        Width="16" Height="16" Opacity="0.6"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
