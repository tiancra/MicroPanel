<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:MicroPanelAvalonia.Models"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="400"
             x:Class="MicroPanelAvalonia.Views.UserManagementDialog"
             Width="450">

  <StackPanel Spacing="16" Margin="24">

    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0"
                 Text="用户管理"
                 FontSize="20"
                 FontWeight="SemiBold"/>
      <Button Grid.Column="1"
              x:Name="CloseButton"
              Classes="Ghost"
              Padding="4"
              Click="OnCloseClick">
        <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                  Width="20" Height="20" Opacity="0.6"/>
      </Button>
    </Grid>

    <TextBlock x:Name="ServerTextBlock"
               Text=""
               FontSize="12"
               Opacity="0.5"
               TextTrimming="CharacterEllipsis"/>

    <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
            CornerRadius="4"
            Padding="12">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0"
                     Text="用户名"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Opacity="0.6"/>
          <TextBlock Grid.Column="1"
                     Text="操作"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Opacity="0.6"
                     Margin="0,0,16,0"/>
        </Grid>

        <ListBox x:Name="UsersListBox"
                 MaxHeight="200"
                 SelectionMode="Single"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="models:ServerUser">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                <TextBlock Grid.Column="0"
                           Text="{Binding Username}"
                           FontSize="14"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4">
                  <Button Classes="Ghost"
                          Padding="6"
                          Tag="{Binding}"
                          Click="OnEditUserClick">
                    <PathIcon Data="M3,17.25V21h3.75L17.81,9.94l-3.75,-3.75L3,17.25zM20.71,7.04c0.39,-0.39 0.39,-1.02 0,-1.41l-2.34,-2.34c-0.39,-0.39 -1.02,-0.39 -1.41,0l-1.83,1.83l3.75,3.75l1.83,-1.83z"
                              Width="16" Height="16" Opacity="0.6"/>
                  </Button>
                  <Button Classes="Ghost"
                          Padding="6"
                          Tag="{Binding}"
                          Click="OnDeleteUserClick">
                    <PathIcon Data="M6,19c0,1.1 0.9,2 2,2h8c1.1,0 2,-0.9 2,-2V7H6v12zM19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z"
                              Width="16" Height="16" Opacity="0.6"/>
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <Button x:Name="AddUserButton"
            HorizontalAlignment="Stretch"
            Click="OnAddUserClick">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <PathIcon Data="M19,13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                  Width="18" Height="18"/>
        <TextBlock Text="添加用户"/>
      </StackPanel>
    </Button>
  </StackPanel>
</UserControl>
