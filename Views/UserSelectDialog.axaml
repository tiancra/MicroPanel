<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:MicroPanelAvalonia.Models"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="300"
             x:Class="MicroPanelAvalonia.Views.UserSelectDialog"
             Width="350">

  <StackPanel Spacing="16" Margin="24">

    <TextBlock Text="选择用户登录"
               FontSize="20"
               FontWeight="SemiBold"/>

    <TextBlock x:Name="ServerTextBlock"
               Text=""
               FontSize="14"
               Opacity="0.6"
               TextTrimming="CharacterEllipsis"/>

    <ListBox x:Name="UsersListBox"
             MaxHeight="200"
             SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="models:ServerUser">
          <Grid ColumnDefinitions="Auto,*" Margin="4">
            <PathIcon Grid.Column="0"
                      Data="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z"
                      Width="20" Height="20"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding Username}"
                         FontSize="14"
                         FontWeight="SemiBold"/>
              <TextBlock Text="{Binding TokenExpiry, StringFormat='Token 过期: {0:yyyy-MM-dd HH:mm}', FallbackValue='未登录'}"
                         FontSize="11"
                         Opacity="0.5"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel x:Name="ErrorPanel"
                Spacing="8"
                IsVisible="False">
      <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
              CornerRadius="4"
              Padding="12,8">
        <TextBlock x:Name="ErrorTextBlock"
                   Text=""
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"/>
      </Border>
    </StackPanel>

    <StackPanel x:Name="ProgressPanel"
                Spacing="8"
                IsVisible="False"
                HorizontalAlignment="Center">
      <ProgressBar IsIndeterminate="True" Width="32" Height="32"/>
      <TextBlock Text="正在登录..."
                 Opacity="0.6"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,8,0,0">
      <Button x:Name="CancelButton"
              Content="取消"
              Click="OnCancelClick"/>
      <Button x:Name="LoginButton"
              Content="登录"
              Classes="Accent"
              Click="OnLoginClick"/>
    </StackPanel>
  </StackPanel>
</UserControl>
