<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MicroPanelAvalonia.Views.Controls"
        x:Class="MicroPanelAvalonia.Views.Windows.LogWindow"
        Title="日志输出"
        Width="900"
        Height="600"
        MinWidth="300"
        MinHeight="200"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome">
  <Grid RowDefinitions="Auto,*">
    <!-- 顶部工具栏 -->
    <Border Grid.Row="0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0"
                   Text="实时日志输出"
                   FontSize="14"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        
        <StackPanel Grid.Column="2" 
                    Orientation="Horizontal" 
                    Spacing="8">
          <Border x:Name="ConnectionStatusBorder"
                  Background="{DynamicResource SystemFillColorCautionBrush}"
                  CornerRadius="4"
                  Padding="6,2">
            <TextBlock x:Name="ConnectionStatusText"
                       Text="未连接"
                       FontSize="11"
                       Foreground="White"/>
          </Border>
          <Button x:Name="ClearButton"
                  Content="清空"
                  FontSize="12"/>
          <Button x:Name="ReconnectButton"
                  Classes="Accent"
                  Content="重新连接"
                  FontSize="12"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 日志显示区域 -->
    <Border Grid.Row="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
      <Grid RowDefinitions="Auto,*">
        <!-- 终端头部 -->
        <Border Grid.Row="0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" 
                        Orientation="Horizontal" 
                        Spacing="6">
              <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                      CornerRadius="3"
                      Padding="6,2">
                <TextBlock Text="实时输出"
                           FontSize="11"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
              </Border>
            </StackPanel>
            
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        Spacing="6">
              <Slider x:Name="FontSizeSlider"
                      Minimum="10"
                      Maximum="24"
                      Value="14"
                      Width="100"
                      VerticalAlignment="Center"/>
              <TextBlock Text="{Binding #FontSizeSlider.Value, StringFormat='{}{0:F0}pt'}"
                         VerticalAlignment="Center"
                         Width="28"
                         FontSize="11"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 日志内容 -->
        <controls:LogViewer Grid.Row="1"
                            x:Name="LogViewer"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            Margin="0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
